<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hitchy" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Main AppCompat theme hosting Compose UI -->
        <!-- Dark status bar icons: the app draws edge to edge on white screens. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Light mode only: no dark theme and no forced dark. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
