{
  "name": "hitchy-functions",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test:unit": "vitest run test/unit",
    "test": "firebase emulators:exec --project demo-hitchy \"vitest run\"",
    "emulators": "firebase emulators:start --project demo-hitchy",
    "seed": "tsx ../seed/seed.ts"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "luxon": "3.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
